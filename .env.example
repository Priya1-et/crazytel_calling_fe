# Copy to .env (gitignored). All keys are read via src/config/env.ts only.

VITE_API_BASE_URL=http://localhost:3001
VITE_SIP_WSS_URL=wss://YOUR_PBX_HOST:8089/ws
VITE_SIP_DOMAIN=YOUR_PBX_HOST
VITE_SIP_USERNAME=venus
VITE_SIP_PASSWORD=

# Optional: comma-separated verified outbound CLI (national digits). If empty, uses 0290178400–0290178499.
# VITE_VERIFIED_OUTBOUND_NUMBERS=0290178400,0290178426

VITE_TURN_URL=stun:stun.l.google.com:19302
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
