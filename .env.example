# Copy to .env (gitignored). All keys are read via src/config/env.ts only.

VITE_API_BASE_URL=http://localhost:3001
VITE_SIP_WSS_URL=wss://YOUR_PBX_HOST:8089/ws
VITE_SIP_DOMAIN=YOUR_PBX_HOST
VITE_SIP_USERNAME=venus
VITE_SIP_PASSWORD=

# Optional: verified outbound CLI (E.164, e.g. 61272643281). Legacy 0272643281 is auto-converted.
# VITE_VERIFIED_OUTBOUND_NUMBERS=61272643281

VITE_TURN_URL=stun:stun.l.google.com:19302
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
